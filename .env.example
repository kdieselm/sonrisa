# Copy to .env and adjust. .env is git-ignored.

# Host ports: the app is opened at http://localhost:WEB_PORT; the API is also reachable directly on API_PORT
WEB_PORT=8080
API_PORT=5080

# PostgreSQL
POSTGRES_DB=alerts
POSTGRES_USER=alerts
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# SMTP (Mailpit in local development; web UI on MAILPIT_UI_PORT)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=alerts@example.local
MAILPIT_UI_PORT=8025

# Slack (optional). Empty = messages go to the local mock receiver in the API.
SLACK_WEBHOOK_URL=

# Market data (both optional). Empty FINNHUB_API_KEY = stocks come from the simulated mock source; empty
# COINGECKO_API_KEY = CoinGecko is called without a key (a free Demo key raises its rate limit).
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# Seeded admin account (local development only)
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-me-Admin1!

# Seeded demo user with an email and a Slack destination and one disaster alert (local development only).
# Leave SEED_DEMO_EMAIL empty to skip it.
SEED_DEMO_EMAIL=demo@example.local
SEED_DEMO_PASSWORD=change-me-Demo1!
